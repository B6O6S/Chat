local function createPoofForCharacter(character, seqId)
    if not character then return end
    local root = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 5)
    if not root then return end
    if seqId and actionState.sequenceId ~= seqId then return end

    local folder = Instance.new("Folder")
    folder.Name = "WhiteCloudPoof"
    folder.Parent = Workspace
    table.insert(actionState.poofFolders, folder)

    local origin = root.Position
    local particles = {}

    for i = 1, POOF_PARTICLE_COUNT do
        local particle = Instance.new("Part")
        particle.Shape = Enum.PartType.Ball
        particle.Material = Enum.Material.SmoothPlastic
        particle.Color = Color3.new(1, 1, 1)
        particle.Transparency = 0.05
        particle.Anchored = true
        particle.CanCollide = false
        particle.CanTouch = false
        particle.CanQuery = false
        particle.CastShadow = false

        local size = math.random(8, 14) / 10
        particle.Size = Vector3.new(size, size, size)

        local offset = Vector3.new(
            math.random(-10, 10) / 10,
            math.random(-5, 10) / 10,
            math.random(-10, 10) / 10
        )

        particle.Position = origin + offset
        particle.Parent = folder

        local direction = Vector3.new(
            math.random(-100, 100) / 100,
            math.random(-20, 100) / 100,
            math.random(-100, 100) / 100
        ).Unit

        particles[i] = {
            part = particle,
            start = particle.Position,
            direction = direction,
            size = size,
            distance = math.random(15, 30) / 10
        }
    end

    local startTime = os.clock()
    local connection

    connection = RunService.Heartbeat:Connect(function()
        local alpha = math.min((os.clock() - startTime) / POOF_DURATION, 1)

        for _, data in ipairs(particles) do
            local particle = data.part

            if particle.Parent then
                local scale = 1 + alpha * 1.5
                local currentSize = data.size * scale

                particle.Size = Vector3.new(
                    currentSize,
                    currentSize,
                    currentSize
                )

                particle.Position = data.start
                    + data.direction * data.distance * alpha
                    + Vector3.new(0, alpha * 1.5, 0)

                particle.Transparency = 0.05 + alpha * 0.95
            end
        end

        if alpha >= 1 then
            connection:Disconnect()
            if folder.Parent then
                pcall(function()
                    folder:Destroy()
                end)
            end
        end
    end)
end

