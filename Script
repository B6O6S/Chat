-- Only show chat log entry and bubble after JSON write + fetch confirms it exists in JSON
local function sendMessage(text)
    if text == "" then return end

    enqueueBinMutation(function(record)
        local messages = {}
        for i, m in ipairs(record.messages or {}) do
            messages[i] = m
        end
        table.insert(messages, {
            user = USERNAME,
            text = text,
            thumb = MY_THUMBNAIL,
            region = playerRegionCode
        })
        while #messages > 50 do
            table.remove(messages, 1)
        end
        return {
            messages = messages,
            adminCommand = record.adminCommand
        }
    end, function()
        pcall(fetchMessages)
    end)
end

local function triggerSend()
    local txt = TextBox.Text
    if txt ~= "" then
        TextBox.Text = ""
        sendMessage(txt)
    end
end

