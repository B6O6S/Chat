local function destroyFloatPlatform()
    if actionState.floatPlatform then
        pcall(function()
            actionState.floatPlatform:Destroy()
        end)
        actionState.floatPlatform = nil
    end
end

local function createFixedFloatPlatformAt(rootPart, humanoid)
    if not rootPart then return end
    destroyFloatPlatform()

    local hipHeight = (humanoid and humanoid.HipHeight and humanoid.HipHeight > 0) and humanoid.HipHeight or 2
    local platformY = rootPart.Position.Y - hipHeight - 1.25

    local part = Instance.new("Part")
    part.Name = "DeltaFloatPlatform"
    part.Size = Vector3.new(6, 0.5, 6)
    part.CFrame = CFrame.new(rootPart.Position.X, platformY, rootPart.Position.Z)
    part.Anchored = true
    part.CanCollide = true
    part.Transparency = 1
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth
    part.Parent = Workspace
    actionState.floatPlatform = part
end

local function stopEmoteLoop()
    if actionState.emoteLoopThread then
        pcall(function()
            task.cancel(actionState.emoteLoopThread)
        end)
        actionState.emoteLoopThread = nil
    end
end

local function stopActionSound()
    if actionState.soundLoopConnection then
        pcall(function()
            actionState.soundLoopConnection:Disconnect()
        end)
        actionState.soundLoopConnection = nil
    end
    if actionState.soundThread then
        pcall(function()
            task.cancel(actionState.soundThread)
        end)
        actionState.soundThread = nil
    end
    if actionState.activeSound then
        pcall(function()
            actionState.activeSound:Stop()
            actionState.activeSound:Destroy()
        end)
        actionState.activeSound = nil
    end
end

local function playOneShotSound(soundId, rootPart)
    if not soundId then return end
    local sound = Instance.new("Sound")
    sound.Name = "DeltaOneShotSound"
    sound.SoundId = soundId
    sound.Looped = false
    sound.Volume = 1
    sound.Parent = rootPart or SoundService
    pcall(function()
        sound:Play()
    end)
    sound.Ended:Connect(function()
        pcall(function()
            sound:Destroy()
        end)
    end)
    task.delay(5, function()
        if sound and sound.Parent then
            pcall(function()
                sound:Destroy()
            end)
        end
    end)
end

local function startLoopingSound(soundId, rootPart, seqId, spawnHeartOnPlay)
    stopActionSound()
    if not soundId then return end

    local sound = Instance.new("Sound")
    sound.Name = "DeltaActionLoopSound"
    sound.SoundId = soundId
    sound.Looped = true
    sound.Volume = 1
    sound.Parent = rootPart or SoundService
    actionState.activeSound = sound

    local function triggerKissHeartOnce()
        if spawnHeartOnPlay and actionState.active and actionState.sequenceId == seqId then
            spawnSingleKissHeart(seqId)
        end
    end

    if spawnHeartOnPlay then
        actionState.soundLoopConnection = sound.DidLoop:Connect(function()
            triggerKissHeartOnce()
        end)
    end

    pcall(function()
        sound:Play()
    end)
    triggerKissHeartOnce()

    actionState.soundThread = task.spawn(function()
        while actionState.active and actionState.sequenceId == seqId and actionState.activeSound do
            if not actionState.activeSound.IsPlaying then
                pcall(function()
                    actionState.activeSound:Play()
                end)
                triggerKissHeartOnce()
            end
            task.wait(0.25)
        end
    end)
end

local function startIntervalSound(soundId, rootPart, intervalSeconds, seqId)
    stopActionSound()
    if not soundId then return end

    local waitTime = intervalSeconds or 1.35
    local sound = Instance.new("Sound")
    sound.Name = "DeltaActionIntervalSound"
    sound.SoundId = soundId
    sound.Looped = false
    sound.Volume = 1
    sound.Parent = rootPart or SoundService
    actionState.activeSound = sound

    actionState.soundThread = task.spawn(function()
        while actionState.active and actionState.sequenceId == seqId and actionState.activeSound do
            pcall(function()
                actionState.activeSound:Stop()
                actionState.activeSound:Play()
            end)
            task.wait(waitTime)
        end
    end)
end

local function hideCharacterClothes(character)
    if not character then return end
    for _, desc in ipairs(character:GetDescendants()) do
        if desc:IsA("Shirt") or desc:IsA("Pants") then
            if desc.Parent ~= nil and actionState.hiddenClothes[desc] == nil then
                actionState.hiddenClothes[desc] = desc.Parent
                pcall(function()
                    desc.Parent = nil
                end)
            end
        end
    end
end

local function activateTorsoAssembliesForCharacters()
    actionState.assembliesActive = true
    destroySpawnedAssemblies()
    actionState.assembliesActive = true

    local b6Player = findPlayerCaseInsensitive("B6O6S")
    local jojoPlayer = findPlayerCaseInsensitive("jojo027212")

    local b6Char = (string.lower(USERNAME) == "b6o6s" and LocalPlayer.Character) or (b6Player and b6Player.Character)
    local jojoChar = (string.lower(USERNAME) == "jojo027212" and LocalPlayer.Character) or (jojoPlayer and jojoPlayer.Character)

    local b6States = {}
    local jojoBallRigs = {}

    if b6Char then
        local st = spawnB6TorsoAssembly(b6Char, "_B6O6S")
        if st then
            table.insert(b6States, st)
        end
    end

    if jojoChar then
        local rig = spawnJojoBallsRig(jojoChar)
        if rig then
            table.insert(jojoBallRigs, rig)
        end
    end

    if #b6States == 0 and #jojoBallRigs == 0 then
        return
    end

    actionState.assemblyRenderConn = RunService.RenderStepped:Connect(function(dt)
        if not actionState.assembliesActive then return end

        local clampedDt = math.min(dt, 0.05)
        if clampedDt <= 0 then return end

        for _, b6State in ipairs(b6States) do
            if B6_ASSEMBLY_CONFIG.JiggleEnabled and b6State.rodWeld and b6State.rodWeld.Parent then
                local torsoPart = b6State.anchorPart
                if torsoPart and torsoPart.Parent then
                    local curVel = torsoPart.AssemblyLinearVelocity
                    local curAngVel = torsoPart.AssemblyAngularVelocity

                    local worldAccel = (curVel - b6State.prevVel) / clampedDt
                    local worldAngAccel = (curAngVel - b6State.prevAngVel) / clampedDt

                    b6State.prevVel = curVel
                    b6State.prevAngVel = curAngVel

                    local localAccel = torsoPart.CFrame:VectorToObjectSpace(worldAccel)
                    local localAngVel = torsoPart.CFrame:VectorToObjectSpace(curAngVel)
                    local localAngAccel = torsoPart.CFrame:VectorToObjectSpace(worldAngAccel)

                    local scale = B6_ASSEMBLY_CONFIG.RotationJiggleScale * 18
                    local rawRot = Vector3.new(
                        (-localAccel.Y * 0.012 - localAngAccel.X * 0.015) * scale,
                        (-localAngVel.Y * 0.08 - localAccel.X * 0.015) * scale,
                        (localAccel.X * 0.02 - localAngAccel.Z * 0.015) * scale
                    )

                    local maxTilt = B6_ASSEMBLY_CONFIG.MaxTiltRad
                    local targetRot = Vector3.new(
                        math.clamp(rawRot.X, -maxTilt, maxTilt),
                        math.clamp(rawRot.Y, -maxTilt, maxTilt),
                        math.clamp(rawRot.Z, -maxTilt, maxTilt)
                    )

                    local rotForce = (targetRot - b6State.rotOffset) * B6_ASSEMBLY_CONFIG.Stiffness - b6State.rotVel * B6_ASSEMBLY_CONFIG.Damping
                    b6State.rotVel += rotForce * clampedDt
                    b6State.rotOffset = Vector3.new(
                        math.clamp(b6State.rotOffset.X + b6State.rotVel.X * clampedDt, -maxTilt, maxTilt),
                        math.clamp(b6State.rotOffset.Y + b6State.rotVel.Y * clampedDt, -maxTilt, maxTilt),
                        math.clamp(b6State.rotOffset.Z + b6State.rotVel.Z * clampedDt, -maxTilt, maxTilt)
                    )

                    b6State.rodWeld.C0 = b6State.baseRodC0 * CFrame.Angles(b6State.rotOffset.X, b6State.rotOffset.Y, b6State.rotOffset.Z)
                end
            end
        end

        for _, rig in ipairs(jojoBallRigs) do
            if rig.character and rig.character.Parent and rig.torso and rig.torso.Parent then
                local torso = rig.torso
                rig.skinBall.Color = torso.Color
                rig.skinBall.CFrame = torso.CFrame * CFrame.new(JOJO_BALL_CONFIG.SkinOffset)

                rig.salmonBall.CFrame = torso.CFrame * CFrame.new(
                    JOJO_BALL_CONFIG.SalmonOffset + Vector3.new(JOJO_BALL_CONFIG.StickDistance, 0, 0)
                )

                for _, data in ipairs(rig.extraBalls) do
                    if data.ball1 and data.ball2 then
                        if data.ball1.Color ~= JOJO_BALL_CONFIG.SalmonColor then
                            data.ball1.Color = torso.Color
                            data.ball2.Color = torso.Color
                        end

                        data.ball1.CFrame = torso.CFrame * CFrame.new(data.offset)

                        data.ball2.CFrame = torso.CFrame * CFrame.new(
                            data.offset + Vector3.new(data.stickDistance, 0, 0)
                        )
                    end
                end
            end
        end
    end)
end

local function setClothesHiddenForPlayers(enabled, includeAssemblies)
    if enabled then
        hideCharacterClothes(LocalPlayer.Character)
        for adminName, _ in pairs(ADMINS) do
            if string.lower(USERNAME) ~= adminName then
                local otherPlr = findPlayerCaseInsensitive(adminName)
                if otherPlr and otherPlr.Character then
                    hideCharacterClothes(otherPlr.Character)
                end
            end
        end
        if includeAssemblies then
            activateTorsoAssembliesForCharacters()
        end
    else
        destroySpawnedAssemblies()
        for cloth, originalParent in pairs(actionState.hiddenClothes) do
            if cloth and originalParent and originalParent.Parent then
                pcall(function()
                    cloth.Parent = originalParent
                end)
            end
        end
        actionState.hiddenClothes = {}
        WearButton.Visible = false
    end
end

local function applyNoCollisionToCharacter(character)
    if not character then return end
    for _, desc in ipairs(character:GetDescendants()) do
        if desc:IsA("BasePart") then
            if actionState.partStates[desc] == nil then
                actionState.partStates[desc] = {
                    CanCollide = desc.CanCollide,
                    Massless = desc.Massless
                }
            end
            desc.CanCollide = false
            desc.Massless = true
            desc.AssemblyLinearVelocity = Vector3.zero
            desc.AssemblyAngularVelocity = Vector3.zero
        end
    end
end

local function applyNearbyWorldPassThrough(rootPart)
    if not rootPart then return end
    local char = LocalPlayer.Character
    local overlapParams = OverlapParams.new()
    overlapParams.FilterType = Enum.RaycastFilterType.Exclude
    overlapParams.FilterDescendantsInstances = char and { char } or {}

    local parts = Workspace:GetPartBoundsInRadius(rootPart.Position, 6, overlapParams)
    for _, part in ipairs(parts) do
        if part:IsA("BasePart") and part ~= actionState.floatPlatform and part.CanCollide and not part:IsDescendantOf(char) then
            if actionState.worldPartStates[part] == nil then
                actionState.worldPartStates[part] = part.CanCollide
            end
            part.CanCollide = false
        end
    end
end

local function restoreWorldPassThrough()
    for part, origCollide in pairs(actionState.worldPartStates) do
        if part and part.Parent then
            pcall(function()
                part.CanCollide = origCollide
            end)
        end
    end
    actionState.worldPartStates = {}
end

local function setPassThroughNoPush(enabled, allowWorldPassThrough)
    if actionState.noclipConnection then
        actionState.noclipConnection:Disconnect()
        actionState.noclipConnection = nil
    end

    destroyFloatPlatform()
    restoreWorldPassThrough()
    for part, saved in pairs(actionState.partStates) do
        if part and part.Parent then
            pcall(function()
                part.CanCollide = saved.CanCollide
                part.Massless = saved.Massless
            end)
        end
    end
    actionState.partStates = {}

    actionState.allowWorldPassThrough = allowWorldPassThrough == true

    if enabled then
        actionState.noclipConnection = RunService.Stepped:Connect(function()
            if not actionState.active then return end
            local myChar = LocalPlayer.Character
            applyNoCollisionToCharacter(myChar)

            if actionState.allowWorldPassThrough then
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                applyNearbyWorldPassThrough(myRoot)
            end

            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    applyNoCollisionToCharacter(plr.Character)
                end
            end
        end)
    else
        actionState.allowWorldPassThrough = false
    end
end

local function stopCurrentEmoteTracks(humanoid)
    if not humanoid then return end
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if animator then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            pcall(function()
                track:Stop(0)
            end)
        end
    end
end

local function restoreHumanoidMovement(humanoid, root)
    if root then
        root.Anchored = false
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
    if humanoid then
        humanoid.PlatformStand = false
        humanoid.UseJumpPower = actionState.baselineUseJumpPower
        local targetJump = (actionState.baselineJumpPower and actionState.baselineJumpPower > 0) and actionState.baselineJumpPower or 50
        if humanoid.UseJumpPower then
            humanoid.JumpPower = targetJump
        else
            humanoid.JumpHeight = targetJump
        end
        local targetSpeed = (actionState.baselineWalkSpeed and actionState.baselineWalkSpeed > 0) and actionState.baselineWalkSpeed or 16
        humanoid.WalkSpeed = targetSpeed
    end
end

local function restoreClothesOnly()
    setClothesHiddenForPlayers(false, false)
    WearButton.Visible = false
end

local function unfreezeAction(autoWearClothes)
    actionState.sequenceId = actionState.sequenceId + 1
    actionState.active = false
    stopKissHeartParticles()
    clearPoofFolders()
    stopEmoteLoop()
    stopActionSound()
    StopButton.Visible = false

    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")

    stopCurrentEmoteTracks(humanoid)
    setPassThroughNoPush(false, false)
    restoreHumanoidMovement(humanoid, root)

    if autoWearClothes then
        restoreClothesOnly()
    end
end

local function triggerStripClothesSequence(seqId)
    if not isAdmin(USERNAME) then return end

    actionState.sequenceId = actionState.sequenceId + 1
    local mySeq = seqId or actionState.sequenceId

    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

    playOneShotSound(RIP_CLOTHES_SOUND_ID, myRoot)
    setClothesHiddenForPlayers(true, true)

    local spawnedChars = {}
    local function spawnPoofOnce(char)
        if not char or spawnedChars[char] then return end
        spawnedChars[char] = true
        task.spawn(function()
            createPoofForCharacter(char, mySeq)
        end)
    end

    if myChar then
        spawnPoofOnce(myChar)
    end

    for adminName, _ in pairs(ADMINS) do
        local plr = findPlayerCaseInsensitive(adminName)
        if plr and plr.Character then
            spawnPoofOnce(plr.Character)
        end
    end

    for _, model in ipairs(Workspace:GetChildren()) do
        if model:IsA("Model") and model:FindFirstChildOfClass("Humanoid") then
            local lowerModel = string.lower(model.Name)
            if ADMINS[lowerModel] then
                spawnPoofOnce(model)
            end
        end
    end

    WearButton.Visible = true
end

local function prepareCleanActionState(humanoid, root, preserveAssemblies)
    actionState.sequenceId = actionState.sequenceId + 1
    local mySeq = actionState.sequenceId

    stopKissHeartParticles()
    stopEmoteLoop()
    stopActionSound()
    if not preserveAssemblies then
        setClothesHiddenForPlayers(false, false)
    end
    stopCurrentEmoteTracks(humanoid)
    setPassThroughNoPush(false, false)

    if not actionState.active then
        syncBaselineFromHumanoid(humanoid)
    end

    restoreHumanoidMovement(humanoid, root)
    actionState.active = true
    return mySeq
end

local function triggerBringSequence(initiatorName)
    if not isAdmin(USERNAME) then return end

    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not character or not humanoid or not root then return end

    local mySeq = prepareCleanActionState(humanoid, root, actionState.assembliesActive)
    setPassThroughNoPush(true, false)

    local initiatorLower = string.lower(initiatorName or "b6o6s")
    local myLower = string.lower(USERNAME)

    if myLower ~= initiatorLower then
        local anchorPlayer = findPlayerCaseInsensitive(initiatorName)
        local anchorChar = anchorPlayer and anchorPlayer.Character
        local anchorRoot = anchorChar and anchorChar:FindFirstChild("HumanoidRootPart")

        if anchorRoot then
            local bringPos = anchorRoot.Position + (anchorRoot.CFrame.LookVector * 1.75)
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = CFrame.lookAt(bringPos, anchorRoot.Position)
        end
    end

    task.delay(1.2, function()
        if actionState.active and actionState.sequenceId == mySeq then
            unfreezeAction(false)
        end
    end)
end

local function triggerPairedEmoteSequence(initiatorName, emoteMap, soundConfig, customMode)
    if not isAdmin(USERNAME) then return end

    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not character or not humanoid or not root then return end

    local equipsAssembly = (customMode == "lick" or customMode == "yummy")
    local mySeq = prepareCleanActionState(humanoid, root, equipsAssembly or actionState.assembliesActive)

    local initiatorLower = string.lower(initiatorName or "b6o6s")
    local myLower = string.lower(USERNAME)
    local usesFixedPlatform = (
        (customMode == "yummy" and myLower == "jojo027212")
        or (customMode == "kisshug" and myLower == "jojo027212")
        or (customMode == "lick" and myLower == "b6o6s")
    )

    setPassThroughNoPush(true, usesFixedPlatform)

    if customMode == "romanticdance" then
        local b6Player = findPlayerCaseInsensitive("B6O6S")
        local jojoPlayer = findPlayerCaseInsensitive("jojo027212")
        local b6Root = b6Player and b6Player.Character and b6Player.Character:FindFirstChild("HumanoidRootPart")
        local jojoRoot = jojoPlayer and jojoPlayer.Character and jojoPlayer.Character:FindFirstChild("HumanoidRootPart")
        local anchorPlayer = findPlayerCaseInsensitive(initiatorName)
        local anchorRoot = anchorPlayer and anchorPlayer.Character and anchorPlayer.Character:FindFirstChild("HumanoidRootPart")

        local refRoot = b6Root or jojoRoot or anchorRoot
        if refRoot then
            local baseCF = refRoot.CFrame
            local forwardDir = baseCF.LookVector
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = CFrame.lookAt(baseCF.Position, baseCF.Position + forwardDir)
        end
    elseif customMode == "kisshug" then
        local b6Player = findPlayerCaseInsensitive("B6O6S")
        local jojoPlayer = findPlayerCaseInsensitive("jojo027212")
        local b6Root = b6Player and b6Player.Character and b6Player.Character:FindFirstChild("HumanoidRootPart")
        local jojoRoot = jojoPlayer and jojoPlayer.Character and jojoPlayer.Character:FindFirstChild("HumanoidRootPart")
        local anchorPlayer = findPlayerCaseInsensitive(initiatorName)
        local anchorRoot = anchorPlayer and anchorPlayer.Character and anchorPlayer.Character:FindFirstChild("HumanoidRootPart")

        local refRoot = b6Root or anchorRoot or jojoRoot
        if refRoot then
            local baseCF = refRoot.CFrame
            local forwardDir = baseCF.LookVector
            if myLower == "b6o6s" then
                local frontPos = baseCF.Position
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                root.CFrame = CFrame.lookAt(frontPos, frontPos + forwardDir)
            elseif myLower == "jojo027212" then
                local backPos = baseCF.Position + (forwardDir * 0.5) - Vector3.new(0, 0.4, 0)
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                root.CFrame = CFrame.lookAt(backPos, backPos - forwardDir)
                applyNearbyWorldPassThrough(root)
                createFixedFloatPlatformAt(root, humanoid)
            else
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                root.CFrame = baseCF
            end
        end
    elseif customMode == "slap" then
        local b6Player = findPlayerCaseInsensitive("B6O6S")
        local jojoPlayer = findPlayerCaseInsensitive("jojo027212")
        local b6Root = b6Player and b6Player.Character and b6Player.Character:FindFirstChild("HumanoidRootPart")
        local jojoRoot = jojoPlayer and jojoPlayer.Character and jojoPlayer.Character:FindFirstChild("HumanoidRootPart")
        local anchorPlayer = findPlayerCaseInsensitive(initiatorName)
        local anchorRoot = anchorPlayer and anchorPlayer.Character and anchorPlayer.Character:FindFirstChild("HumanoidRootPart")

        local jojoRef = jojoRoot or (myLower == "jojo027212" and root) or anchorRoot or b6Root
        if jojoRef then
            local baseCF = jojoRef.CFrame
            local forwardDir = baseCF.LookVector
            if myLower == "b6o6s" then
                local frontPos = baseCF.Position + (forwardDir * 1.8)
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                root.CFrame = CFrame.lookAt(frontPos, baseCF.Position)
            elseif myLower == "jojo027212" then
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                root.CFrame = baseCF
            else
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                root.CFrame = baseCF
            end
        end
    elseif customMode == "lick" then
        setClothesHiddenForPlayers(true, true)
        WearButton.Visible = true

        local b6Player = findPlayerCaseInsensitive("B6O6S")
        local jojoPlayer = findPlayerCaseInsensitive("jojo027212")
        local b6Root = b6Player and b6Player.Character and b6Player.Character:FindFirstChild("HumanoidRootPart")
        local jojoRoot = jojoPlayer and jojoPlayer.Character and jojoPlayer.Character:FindFirstChild("HumanoidRootPart")
        local anchorPlayer = findPlayerCaseInsensitive(initiatorName)
        local anchorRoot = anchorPlayer and anchorPlayer.Character and anchorPlayer.Character:FindFirstChild("HumanoidRootPart")

        local jojoRef = jojoRoot or (myLower == "jojo027212" and root) or anchorRoot or b6Root
        if jojoRef then
            local baseCF = jojoRef.CFrame
            local forwardDir = baseCF.LookVector
            if myLower == "b6o6s" then
                local behindPos = baseCF.Position - (forwardDir * 1.25) - Vector3.new(0, 0.5, 0)
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                root.CFrame = CFrame.lookAt(behindPos, behindPos + forwardDir)
                applyNearbyWorldPassThrough(root)
                createFixedFloatPlatformAt(root, humanoid)
            elseif myLower == "jojo027212" then
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                root.CFrame = baseCF
            else
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                root.CFrame = baseCF
            end
        end
    elseif customMode == "yummy" then
        setClothesHiddenForPlayers(true, true)
        WearButton.Visible = true

        local anchorPlayer = findPlayerCaseInsensitive(initiatorName)
        local anchorChar = anchorPlayer and anchorPlayer.Character
        local anchorRoot = anchorChar and anchorChar:FindFirstChild("HumanoidRootPart")

        if anchorRoot then
            local baseCF = anchorRoot.CFrame
            if myLower == "jojo027212" then
                local offsetPos = baseCF.Position - (baseCF.LookVector * 0.9) - Vector3.new(0, 0.5, 0)
                local _, yRot, _ = baseCF:ToEulerAnglesYXZ()
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                root.CFrame = CFrame.new(offsetPos) * CFrame.Angles(0, yRot, 0)
                applyNearbyWorldPassThrough(root)
                createFixedFloatPlatformAt(root, humanoid)
            else
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                root.CFrame = baseCF
            end
        end
    elseif customMode == "stomp" then
        local b6Player = findPlayerCaseInsensitive("B6O6S")
        local jojoPlayer = findPlayerCaseInsensitive("jojo027212")
        local b6Root = b6Player and b6Player.Character and b6Player.Character:FindFirstChild("HumanoidRootPart")
        local jojoRoot = jojoPlayer and jojoPlayer.Character and jojoPlayer.Character:FindFirstChild("HumanoidRootPart")

        if myLower == "b6o6s" then
            local baseRoot = b6Root or jojoRoot
            if baseRoot then
                local forwardDir = baseRoot.CFrame.LookVector
                local frontPos = baseRoot.Position + (forwardDir * 1.5)
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                root.CFrame = CFrame.lookAt(frontPos, frontPos + forwardDir)
            end
        elseif myLower == "jojo027212" then
            local deadline = os.clock() + 0.45
            repeat
                if not actionState.active or actionState.sequenceId ~= mySeq then return end
                local liveB6Root = b6Player and b6Player.Character and b6Player.Character:FindFirstChild("HumanoidRootPart")
                local targetRef = liveB6Root or jojoRoot
                if targetRef then
                    local forwardDir = targetRef.CFrame.LookVector
                    local backPos = targetRef.Position - (forwardDir * 3)
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                    root.CFrame = CFrame.lookAt(backPos, backPos + forwardDir)
                end
                task.wait(0.03)
            until os.clock() >= deadline
        end
    else
        local otherName = (initiatorLower == "b6o6s") and "jojo027212" or "B6O6S"
        if myLower ~= initiatorLower then
            local anchorPlayer = findPlayerCaseInsensitive(initiatorName)
            local anchorChar = anchorPlayer and anchorPlayer.Character
            local anchorRoot = anchorChar and anchorChar:FindFirstChild("HumanoidRootPart")
            if anchorRoot then
                local closePos = anchorRoot.Position + (anchorRoot.CFrame.LookVector * 1.75)
                root.CFrame = CFrame.lookAt(closePos, anchorRoot.Position)
            end
        else
            local otherPlayer = findPlayerCaseInsensitive(otherName)
            local otherChar = otherPlayer and otherPlayer.Character
            local otherRoot = otherChar and otherChar:FindFirstChild("HumanoidRootPart")
            if otherRoot then
                root.CFrame = CFrame.lookAt(root.Position, Vector3.new(otherRoot.Position.X, root.Position.Y, otherRoot.Position.Z))
            end
        end
    end

    task.wait(0.15)
    if not actionState.active or actionState.sequenceId ~= mySeq then return end

    humanoid.PlatformStand = false
    humanoid.WalkSpeed = 0
    if humanoid.UseJumpPower then
        humanoid.JumpPower = 0
    else
        humanoid.JumpHeight = 0
    end

    if usesFixedPlatform then
        root.Anchored = false
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    else
        root.Anchored = true
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end

    task.wait(0.05)
    if not actionState.active or actionState.sequenceId ~= mySeq then return end

    local emoteId = emoteMap and emoteMap[myLower]
    if emoteId then
        pcall(function()
            humanoid:PlayEmoteAndGetAnimTrackById(emoteId)
        end)
        if customMode == "slap" and myLower == "jojo027212" then
            actionState.emoteLoopThread = task.spawn(function()
                while actionState.active and actionState.sequenceId == mySeq do
                    task.wait(0.8)
                    if not actionState.active or actionState.sequenceId ~= mySeq then break end
                    stopCurrentEmoteTracks(humanoid)
                    pcall(function()
                        humanoid:PlayEmoteAndGetAnimTrackById(emoteId)
                    end)
                end
            end)
        end
    end

    local isKissSequence = (customMode == "kiss" or customMode == "kisshug")

    if soundConfig and soundConfig.id then
        if soundConfig.mode == "every1_35s" then
            startIntervalSound(soundConfig.id, root, 1.35, mySeq)
        elseif soundConfig.mode == "every1_5s" then
            startIntervalSound(soundConfig.id, root, 1.5, mySeq)
        elseif soundConfig.mode == "every1s" then
            startIntervalSound(soundConfig.id, root, 1, mySeq)
        else
            startLoopingSound(soundConfig.id, root, mySeq, isKissSequence)
        end
    elseif isKissSequence then
        spawnSingleKissHeart(mySeq)
    end

    StopButton.Visible = true
end

