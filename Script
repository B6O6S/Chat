-- JSONBin Request & Serialized Write Queue (no duplicate retries)
local cachedBinRecord = {
    messages = {},
    adminCommand = nil
}

local function requestJsonBin(method, endpointSuffix, bodyTable)
    local headers = {
        ["X-Master-Key"] = API_KEY
    }
    local payload = {
        Url = "https://api.jsonbin.io/v3/b/" .. BIN_ID .. (endpointSuffix or ""),
        Method = method,
        Headers = headers
    }
    if bodyTable ~= nil then
        headers["Content-Type"] = "application/json"
        payload.Body = HttpService:JSONEncode(bodyTable)
    end

    local ok, res = pcall(function()
        return httpRequest(payload)
    end)
    if ok and res and (res.StatusCode == nil or (res.StatusCode >= 200 and res.StatusCode < 300)) then
        return true, res
    end
    return false, nil
end

local function fetchLatestBinRecord()
    local ok, res = requestJsonBin("GET", "/latest", nil)
    if ok and res and res.Body then
        local parsedOk, decoded = pcall(function()
            return HttpService:JSONDecode(res.Body)
        end)
        if parsedOk and type(decoded) == "table" and type(decoded.record) == "table" then
            cachedBinRecord.messages = type(decoded.record.messages) == "table" and decoded.record.messages or cachedBinRecord.messages
            cachedBinRecord.adminCommand = decoded.record.adminCommand
            return true, cachedBinRecord
        end
    end
    return false, cachedBinRecord
end

local writeQueue = {}
local isProcessingQueue = false

local function enqueueBinMutation(mutateFn, onComplete)
    table.insert(writeQueue, { fn = mutateFn, onComplete = onComplete })
    if isProcessingQueue then return end
    isProcessingQueue = true

    task.spawn(function()
        while #writeQueue > 0 do
            local entry = table.remove(writeQueue, 1)
            local fn = entry.fn
            local onCompleteFn = entry.onComplete
            local wroteOk = false
            pcall(function()
                fetchLatestBinRecord()
                local nextPayload = fn(cachedBinRecord)
                if type(nextPayload) == "table" then
                    cachedBinRecord.messages = nextPayload.messages or cachedBinRecord.messages
                    cachedBinRecord.adminCommand = nextPayload.adminCommand
                    local putOk = requestJsonBin("PUT", "", {
                        messages = cachedBinRecord.messages,
                        adminCommand = cachedBinRecord.adminCommand
                    })
                    wroteOk = putOk == true
                end
            end)
            if wroteOk and onCompleteFn then
                pcall(onCompleteFn)
            end
        end
        isProcessingQueue = false
    end)
end

-- Sends private admin command without showing anything in chat (spam allowed)
local function sendPrivateCommand(commandName)
    enqueueBinMutation(function(record)
        local messages = {}
        for i, m in ipairs(record.messages or {}) do
            messages[i] = m
        end
        local cmdId = tostring(os.clock()) .. "_" .. tostring(os.time()) .. "_" .. tostring(math.random(100000, 999999))
        local newCmd = {
            id = cmdId,
            sender = USERNAME,
            command = commandName,
            time = os.time()
        }
        return {
            messages = messages,
            adminCommand = newCmd
        }
    end)
end

local function dispatchPrivateCommandSafely(commandName)
    if not isAdmin(USERNAME) then return end
    sendPrivateCommand(commandName)
end

