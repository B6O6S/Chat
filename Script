local function cfFromArray(t)
    return CFrame.new(
        t[1], t[2], t[3],
        t[4], t[5], t[6],
        t[7], t[8], t[9],
        t[10], t[11], t[12]
    )
end

local function buildMeshPart(spec, parent, anchored, forceSpecialMesh)
    local size = Vector3.new(spec.Size.x, spec.Size.y, spec.Size.z)
    local part

    if not forceSpecialMesh then
        local ok, mp = pcall(function()
            local m = Instance.new("MeshPart")
            m.MeshId = spec.MeshId
            if spec.TextureID and spec.TextureID ~= "" then
                m.TextureID = spec.TextureID
            end
            m.DoubleSided = spec.DoubleSided == true
            m.Size = size
            return m
        end)
        if ok and mp then
            part = mp
        end
    end

    if not part then
        part = Instance.new("Part")
        part.Size = size

        local mesh = Instance.new("SpecialMesh")
        mesh.MeshType = Enum.MeshType.FileMesh
        mesh.MeshId = spec.MeshId
        if spec.TextureID and spec.TextureID ~= "" then
            mesh.TextureId = spec.TextureID
        end
        mesh.Scale = Vector3.new(1, 1, 1)
        mesh.Parent = part
    end

    part.Size = size
    part.Name = spec.Name
    part.Color = Color3.fromRGB(spec.Color.r, spec.Color.g, spec.Color.b)
    part.Material = Enum.Material[spec.Material] or Enum.Material.SmoothPlastic
    part.Transparency = spec.Transparency or 0
    part.LocalTransparencyModifier = 0
    part.Reflectance = spec.Reflectance or 0
    part.Massless = spec.Massless == true
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.Anchored = anchored
    part.Parent = parent

    pcall(function()
        ContentProvider:PreloadAsync({ part })
    end)

    return part
end

local function createJojoBall(parent, name, size, color, sideFlat)
    local ball = Instance.new("Part")
    ball.Name = name
    ball.Shape = Enum.PartType.Ball
    ball.Material = Enum.Material.SmoothPlastic
    ball.CanCollide = false
    ball.CanTouch = false
    ball.CanQuery = false
    ball.Anchored = true
    ball.Massless = true
    ball.Size = sideFlat
        and Vector3.new(size * 0.3, size, size)
        or Vector3.new(size, size, size)
    ball.Color = color
    ball.Parent = parent
    return ball
end

local function weldToPart(name, part0, part1, parentInstance)
    local weld = Instance.new("Weld")
    weld.Name = name
    weld.Part0 = part0
    weld.Part1 = part1
    weld.C0 = part0.CFrame:ToObjectSpace(part1.CFrame)
    weld.C1 = CFrame.identity
    weld.Parent = parentInstance
    return weld
end

local function resolveTorsoForCharacter(char)
    if not char then
        return nil
    end
    local torso = char:FindFirstChild("Torso")
    if torso and torso:IsA("BasePart") then
        return torso
    end
    local fallback = char:FindFirstChild("UpperTorso") or char:FindFirstChild("LowerTorso") or char:FindFirstChild("HumanoidRootPart")
    return fallback
end

local function findPlayerCaseInsensitive(targetName)
    if not targetName then return nil end
    local lowerTarget = string.lower(targetName)
    for _, plr in ipairs(Players:GetPlayers()) do
        if string.lower(plr.Name) == lowerTarget then
            return plr
        end
    end
    return nil
end

-- Teleports whichever player did NOT click the command to the player who clicked it
local function teleportNonSenderToInitiator(initiatorName)
    if not initiatorName then return end
    if string.lower(USERNAME) == string.lower(initiatorName) then return end

    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local senderPlayer = findPlayerCaseInsensitive(initiatorName)
    local senderRoot = senderPlayer and senderPlayer.Character and senderPlayer.Character:FindFirstChild("HumanoidRootPart")

    if myRoot and senderRoot then
        local destPos = senderRoot.Position + (senderRoot.CFrame.LookVector * 1.75)
        myRoot.AssemblyLinearVelocity = Vector3.zero
        myRoot.AssemblyAngularVelocity = Vector3.zero
        myRoot.CFrame = CFrame.lookAt(destPos, senderRoot.Position)
    end
end

