local function syncBaselineFromHumanoid(humanoid)
    if not humanoid or actionState.active then return end
    if humanoid.WalkSpeed > 0 then
        actionState.baselineWalkSpeed = humanoid.WalkSpeed
    end
    actionState.baselineUseJumpPower = humanoid.UseJumpPower
    local jumpVal = humanoid.UseJumpPower and humanoid.JumpPower or humanoid.JumpHeight
    if jumpVal > 0 then
        actionState.baselineJumpPower = jumpVal
    end
end

