local function fetchMessages()
    local success, rec = fetchLatestBinRecord()
    if success and rec then
        local messages = rec.messages or {}
        local adminCmd = rec.adminCommand
        
        for _, child in ipairs(ChatScroll:GetChildren()) do
            if child:IsA("Frame") then child:Destroy() end
        end
        
        for _, msg in ipairs(messages) do
            addMessage(msg.user, msg.text, msg.thumb, msg.region)
        end

        -- Private admin command listener (hidden from public chat messages)
        if adminCmd and type(adminCmd) == "table" and adminCmd.id then
            if isInitialLoad then
                lastProcessedCommandId = adminCmd.id
            elseif adminCmd.id ~= lastProcessedCommandId then
                lastProcessedCommandId = adminCmd.id
                if isAdmin(USERNAME) and isAdmin(adminCmd.sender) then
                    teleportNonSenderToInitiator(adminCmd.sender)
                    if adminCmd.command == "Hug!" then
                        task.spawn(function()
                            triggerPairedEmoteSequence(adminCmd.sender, HUG_EMOTES, nil, "hug")
                        end)
                    elseif adminCmd.command == "Bring!" then
                        task.spawn(function()
                            triggerBringSequence(adminCmd.sender)
                        end)
                    elseif adminCmd.command == "Kiss!" then
                        task.spawn(function()
                            triggerPairedEmoteSequence(adminCmd.sender, KISS_EMOTES, { id = KISS_SOUND_ID, mode = "loop" }, "kiss")
                        end)
                    elseif adminCmd.command == "KissHug!" then
                        task.spawn(function()
                            triggerPairedEmoteSequence(adminCmd.sender, KISS_HUG_EMOTES, { id = KISS_SOUND_ID, mode = "loop" }, "kisshug")
                        end)
                    elseif adminCmd.command == "Stomp!" then
                        task.spawn(function()
                            triggerPairedEmoteSequence(adminCmd.sender, STOMP_EMOTES, nil, "stomp")
                        end)
                    elseif adminCmd.command == "Slap!" then
                        task.spawn(function()
                            triggerPairedEmoteSequence(adminCmd.sender, SLAP_EMOTES, { id = SLAP_SOUND_ID, mode = "loop" }, "slap")
                        end)
                    elseif adminCmd.command == "RomanticDance!" then
                        task.spawn(function()
                            triggerPairedEmoteSequence(adminCmd.sender, ROMANTIC_DANCE_EMOTES, nil, "romanticdance")
                        end)
                    elseif adminCmd.command == "Yummy!" then
                        task.spawn(function()
                            triggerPairedEmoteSequence(adminCmd.sender, YUMMY_EMOTES, { id = YUMMY_SOUND_ID, mode = "every1_35s" }, "yummy")
                        end)
                    elseif adminCmd.command == "Lick!" then
                        task.spawn(function()
                            triggerPairedEmoteSequence(adminCmd.sender, LICK_EMOTES, { id = LICK_SOUND_ID, mode = "loop" }, "lick")
                        end)
                    elseif adminCmd.command == "Strip!" then
                        task.spawn(function()
                            triggerStripClothesSequence()
                        end)
                    elseif adminCmd.command == "Unstrip!" then
                        task.spawn(function()
                            restoreClothesOnly()
                        end)
                    elseif adminCmd.command == "Stop!" then
                        task.spawn(function()
                            unfreezeAction(true)
                        end)
                    end
                end
            end
        end
        
        if #messages > 0 then
            local latestMsg = messages[#messages]
            local latestMsgId = latestMsg.user .. "_" .. latestMsg.text .. "_" .. #messages
            
            if isInitialLoad then
                lastShownMessageId = latestMsgId
                isInitialLoad = false
            else
                if latestMsgId ~= lastShownMessageId
                    and latestMsg.text ~= "1/#;"
                    and latestMsg.text ~= "Hug!"
                    and latestMsg.text ~= "Bring!"
                    and latestMsg.text ~= "Kiss!"
                    and latestMsg.text ~= "KissHug!"
                    and latestMsg.text ~= "Stomp!"
                    and latestMsg.text ~= "Slap!"
                    and latestMsg.text ~= "RomanticDance!"
                    and latestMsg.text ~= "Yummy!"
                    and latestMsg.text ~= "Lick!"
                    and latestMsg.text ~= "Strip!"
                    and latestMsg.text ~= "Unstrip!"
                    and latestMsg.text ~= "Stop!" then
                    lastShownMessageId = latestMsgId
                    
                    -- Increment unread badge if chat window is toggled off
                    if not MainFrame.Visible and latestMsg.user ~= USERNAME then
                        unreadCount = unreadCount + 1
                        UnreadBadge.Text = tostring(unreadCount)
                        UnreadBadge.Visible = true
                    end
                    
                    -- Show overhead chat bubble only after message is confirmed in JSON
                    showPlayerChatBubble(latestMsg.user, latestMsg.text)
                end
            end
        else
            isInitialLoad = false
        end
    end
end

